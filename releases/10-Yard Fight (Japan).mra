<misterromdescription>
	<name>10-Yard Fight</name>
	<region>Japan</region>
	<platform>Irem M58</platform>
	<year>1983</year>
	<manufacturer>Irem</manufacturer>
	<category>Sports</category>

	<setname>10yardj</setname>
	<parent>10yard</parent>
	<mameversion>0284</mameversion>
	<rbf>10yardfight</rbf>

	<resolution>15kHz</resolution>
	<rotation>horizontal</rotation>
	<flip>no</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<num_buttons>2</num_buttons>
	<buttons default="A,B,Start,Select,R,L" names="Run/Pass,Jump/Tackle,Start 1P,Start 2P,Coin,Pause"></buttons>

	<switches default="FF,FD">
		<dip bits="2,3" name="Time Reduced by Ball Dead" ids="x1.8,x1.5,x1.3,Normal"></dip>
		<dip bits="4,7" name="Coinage" ids="Free Play,1C/1C" values="16,15"></dip>
		<dip bits="8" name="Flip Screen" ids="On,Off"></dip>
		<dip bits="9" name="Cabinet" ids="Upright,Cocktail"></dip>
		<dip bits="10" name="Coin Mode" ids="Mode 2,Mode 1"></dip>
		<dip bits="11" name="Slow Motion (Cheat)" ids="On,Off"></dip>
		<dip bits="12" name="Stop Mode (Cheat)" ids="On,Off"></dip>
		<dip bits="13" name="Level Select (Cheat)" ids="On,Off"></dip>
		<dip bits="14" name="Invulnerability (Cheat)" ids="On,Off"></dip>
		<dip bits="15" name="Service Mode" ids="On,Off"></dip>
	</switches>

	<rom index="0" zip="10yardj.zip|10yard.zip" md5="none">
		<!-- 00000-1FFFF  Z80 program -->
		<part crc="4586114f" name="yf-a.3p"/>
		<part crc="947fa760" name="yf-a.3n"/>
		<part crc="d4975633" name="yf-a.3m"/>
		<part repeat="0x1A000">FF</part>

		<!-- 20000-2FFFF  sound board 6803, ROMs at 0x8000-0xFFFF -->
		<part repeat="0x8000">FF</part>
		<part crc="0392a60c" name="yf-s.3b"/>
		<part crc="6588f41a" name="yf-s.1b"/>
		<part crc="bd054e44" name="yf-s.3a"/>
		<part crc="2490d4c3" name="yf-s.1a"/>

		<!-- 30000-4FFFF  tiles, lane 0 = MSB plane -->
		<interleave output="32">
			<part crc="77e9e9cc" name="yf-a.3e" map="0001"/>
			<part crc="854d5ff4" name="yf-a.3d" map="0010"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="0100"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="77e9e9cc" name="yf-a.3e" map="0001"/>
			<part crc="854d5ff4" name="yf-a.3d" map="0010"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="0100"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="77e9e9cc" name="yf-a.3e" map="0001"/>
			<part crc="854d5ff4" name="yf-a.3d" map="0010"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="0100"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="77e9e9cc" name="yf-a.3e" map="0001"/>
			<part crc="854d5ff4" name="yf-a.3d" map="0010"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="0100"/>
			<part crc="0cd8ffad" name="yf-a.3c" map="1000"/>
		</interleave>

		<!-- 50000-8FFFF  sprites, thirds interleaved -->
		<interleave output="32">
			<part crc="1299ae30" name="yf-b.5b" map="0001"/>
			<part crc="d9bb8ab8" name="yf-b.5f" map="0010"/>
			<part crc="713ef31f" name="yf-b.5j" map="0100"/>
			<part crc="713ef31f" name="yf-b.5j" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="8708b888" name="yf-b.5c" map="0001"/>
			<part crc="47077e8d" name="yf-b.5e" map="0010"/>
			<part crc="f49651cc" name="yf-b.5k" map="0100"/>
			<part crc="f49651cc" name="yf-b.5k" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="1299ae30" name="yf-b.5b" map="0001"/>
			<part crc="d9bb8ab8" name="yf-b.5f" map="0010"/>
			<part crc="713ef31f" name="yf-b.5j" map="0100"/>
			<part crc="713ef31f" name="yf-b.5j" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="8708b888" name="yf-b.5c" map="0001"/>
			<part crc="47077e8d" name="yf-b.5e" map="0010"/>
			<part crc="f49651cc" name="yf-b.5k" map="0100"/>
			<part crc="f49651cc" name="yf-b.5k" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="1299ae30" name="yf-b.5b" map="0001"/>
			<part crc="d9bb8ab8" name="yf-b.5f" map="0010"/>
			<part crc="713ef31f" name="yf-b.5j" map="0100"/>
			<part crc="713ef31f" name="yf-b.5j" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="8708b888" name="yf-b.5c" map="0001"/>
			<part crc="47077e8d" name="yf-b.5e" map="0010"/>
			<part crc="f49651cc" name="yf-b.5k" map="0100"/>
			<part crc="f49651cc" name="yf-b.5k" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="1299ae30" name="yf-b.5b" map="0001"/>
			<part crc="d9bb8ab8" name="yf-b.5f" map="0010"/>
			<part crc="713ef31f" name="yf-b.5j" map="0100"/>
			<part crc="713ef31f" name="yf-b.5j" map="1000"/>
		</interleave>
		<interleave output="32">
			<part crc="8708b888" name="yf-b.5c" map="0001"/>
			<part crc="47077e8d" name="yf-b.5e" map="0010"/>
			<part crc="f49651cc" name="yf-b.5k" map="0100"/>
			<part crc="f49651cc" name="yf-b.5k" map="1000"/>
		</interleave>

		<!-- 90000-9FFFF  unused -->
		<part repeat="0x10000">FF</part>

		<!-- A0000+  PROMs, positioned for the core's palette RAMs -->
		<part crc="b8554da5" name="yard.1f"/>
		<part repeat="0xE0">FF</part>
		<part crc="e1cdfb06" name="yard.2h"/>
		<part repeat="0x100">FF</part>
		<part crc="08fa5103" name="yard.1c"/>
		<part crc="7c04994c" name="yard.1d"/>
		<part repeat="0x100">FF</part>
		<part crc="cd85b646" name="yard.2n"/>
		<part crc="45384397" name="yard.2m"/>
	</rom>

	<!-- Hiscores, from MAME hiscore.dat (m58.cpp, shared by all six sets).
	     Work RAM is E000-EFFF; the core's 12-bit hiscore port drops the E. -->
	<nvram index="4" size="141"/>
	<rom index="3" md5="none">
		<part>00 00 FF FF 00 FF 00 02 00 02 00 01 11 11 00 00</part>
		<part>00 00 E6 00 00 8A 00 4A</part>
		<part>00 00 E0 08 00 03 00 03</part>
	</rom>

	<remark>Irem M58 hardware. Core derived from the MiSTer Irem M62 core.</remark>
</misterromdescription>
